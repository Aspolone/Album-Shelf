<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>${titoloPagina != null ? titoloPagina : 'AlbumShelf'} - AlbumShelf</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css">
    <link rel="icon" type="image/png" href="${pageContext.request.contextPath}/img/logo-noback.png">
</head>
<body>
<header class="topbar">
    <a href="${pageContext.request.contextPath}/" class="logo">
    	<span class="puntino"></span>
    	ALBUMSHELF
	</a>

    <nav class="menu-principale">
        <a href="${pageContext.request.contextPath}/esplora">ESPLORA</a>
        <a href="${pageContext.request.contextPath}/acquista">ACQUISTA</a>
        <a href="${pageContext.request.contextPath}/vendi">VENDI</a>
        <%
            com.albumshelf.mvc.model.bean.Utente utenteHeader =
                (com.albumshelf.mvc.model.bean.Utente) session.getAttribute("utente");
            if (utenteHeader != null && "admin".equals(utenteHeader.getRuolo())) {
        %>
            <a href="${pageContext.request.contextPath}/admin" style="color:#f15f99;">ADMIN</a>
        <% } %>
    </nav>

    <div class="barra-ricerca">
        <form action="${pageContext.request.contextPath}/ricerca" method="GET">
            <input type="text" id="campo-ricerca" name="q" autocomplete="off" placeholder="Cerca...">
        </form>
        
        <ul id="risultati-ricerca" hidden></ul>
    </div>

    <script>
        const MY_CONTEXT_PATH = '${pageContext.request.contextPath}';
    </script>
    <script src="${pageContext.request.contextPath}/js/ricerca.js"></script>

    <a href="${pageContext.request.contextPath}/carrello" class="carrello">
        <img src="${pageContext.request.contextPath}/img/icons-shopping-cart.png" class="icona-carrello" alt="">
    </a>

    <% if (session.getAttribute("utente") != null) { %>
        <a href="${pageContext.request.contextPath}/profilo" class="link-profilo">
            <img src="${pageContext.request.contextPath}/img/icons-customer.png"
                 alt="Profilo" class="icona-profilo">
        </a>
    <% } else { %>
        <a href="${pageContext.request.contextPath}/auth" class="link-accesso">Sign In</a>
    <% } %>
</header>